---
import type { GetStaticPaths } from "astro";
import MainLayout from "@layouts/MainLayout.astro";
import { type PokemonList } from "@interfaces/pokemonList.response";
import PokemonCard from "@components/pokemons/PokemonCard.astro";
import Title from "@components/shared/Title.astro";

export const getStaticPaths = (async ({ paginate }) => {
  const response = await fetch("https://pokeapi.co/api/v2/pokemon?limit=151");
  const data = (await response.json()) as PokemonList;
  return paginate(data.results, { pageSize: 20 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<MainLayout title="Pokemons | Home">
  <Title>Listado de Pokemons </Title>
  <hr />

  <section
    class="grid grid-cols-1 sm:grid-cols-3 md:grid-cols-5 gap-6 my-5"
    aria-label="Listado de Pokemons"
  >
    {
      page.data.map((result) => (
        <PokemonCard
          name={result.name}
          url={result.url}
        />
      ))
    }
  </section>

  <section class="flex px-10-mt-10 gap-2 items-center">
    {
      page.url.prev && (
        <a
          class="btn"
          href={page.url.prev}
          class:list={{ disabled: !page.url.prev }}
        >
          Anteriores
        </a>
      )
    }

    <div class="flex">
      <span class="text-white font-bold">Página {page.currentPage}</span>
    </div>
    <a
      class="btn"
      href={page.url.next}
      class:list={{ disabled: !page.url.next }}
      >Siguientes</a
    >
  </section>
</MainLayout>

<style>
  @reference "../../styles/global.css"

  .btn {
    @apply p-2 bg-blue-400 text-white rounded-md;
  }

  .disabled {
    @apply opacity-5 pointer-events-none cursor-not-allowed;
  }
</style>
