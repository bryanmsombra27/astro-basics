---
const links = [
  { href: "/", name: "Listado" },
  { href: "/pokemons/1", name: "Paginado" },
  { href: "/favorites", name: "Favoritos" },
  { href: "/islas", name: "Islas" },
];
const currentPath = Astro.url.pathname;
---

<!-- component -->
<nav class="shadow bg-slate-800">
  <div
    class="container flex items-center justify-center p-6 mx-auto text-gray-600 capitalize dark:text-gray-300"
  >
    <!-- {
      links.map((link) => (
        <a
          href={link.href}
          class:list={[
            "text-gray-800 dark:text-gray-200 mx-1.5 sm:mx-6",
            {
              "border-b-2 border-blue-500": currentPath == link.href,
            },
          ]}
        >
          {link.name}
        </a>
      ))
    } -->

    {
      links.map((link) => (
        <div>
          <a
            href={link.href}
            class="text-gray-800 dark:text-gray-200 mx-1.5 sm:mx-6"
          >
            {link.name}
          </a>
          {currentPath == link.href ? (
            <div
              class="border-b-2 border-blue-500 mx-4"
              transition:name="menu-line"
            />
          ) : (
            <div
              class="border-b-2 border-transparent"
              transition:name="menu-line"
            />
          )}
        </div>
      ))
    }
  </div>
</nav>
